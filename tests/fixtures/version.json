          "path": "netty/common.jar",
          "url": "https://fixture/netty"
        }
      }
    },
    {
      "name": "it.unimi.dsi:fastutil:8.5.18",
      "downloads": {
        "artifact": {
          "path": "it/unimi/dsi/fastutil/8.5.18/fastutil-8.5.18.jar",
          "url": "https://fixture/fastutil"
        }
      }
    },
    {
      "name": "org.lwjgl:lwjgl:1:natives-windows",
      "rules": [
        {
          "action": "allow",
          "os": {
            "name": "windows"
          }
        }
      ],
      "downloads": {
        "artifact": {
          "path": "lwjgl/native.jar",
          "url": "https://fixture/native"
        }
      }
    },
    {
      "name": "org.lwjgl:lwjgl:1:natives-windows-arm64",
      "rules": [
        {
          "action": "allow",
          "os": {
            "name": "windows"
          }
        }
      ],
      "downloads": {
        "artifact": {
          "path": "lwjgl/arm.jar",
          "url": "https://fixture/arm"
        }
      }
    }
  ],
  "arguments": {
    "jvm": [
      "-Djava.library.path=${natives_directory}",
      "-cp",
      "${classpath}"
